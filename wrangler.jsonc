{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stripe-demo",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/create-checkout-session",
      "/create-setup-session"
    ]
  }
}